# Public client configuration.
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Exact trusted app origin used to validate SIWE domain and URI.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Supabase credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server-only Sepolia JSON-RPC endpoint used for smart-contract wallet signature verification.
SEPOLIA_RPC_URL=
